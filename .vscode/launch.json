{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "validate (full scale)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/harness/validate.py",
      "args": ["--scaling", "1.0", "--T", "10"],
      "cwd": "${workspaceFolder}/harness",
      "console": "integratedTerminal"
    },
    {
      "name": "benchmark (sweep)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/harness/benchmark.py",
      "args": ["--scalings", "0.1", "0.5", "1.0", "--T", "10", "--repeats", "3"],
      "cwd": "${workspaceFolder}/harness",
      "console": "integratedTerminal"
    },
    {
      "name": "benchmark (quick smoke)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/harness/benchmark.py",
      "args": ["--quick"],
      "cwd": "${workspaceFolder}/harness",
      "console": "integratedTerminal"
    },
    {
      "name": "finite_size",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/harness/finite_size.py",
      "cwd": "${workspaceFolder}/harness",
      "console": "integratedTerminal"
    },
    {
      "name": "compare_backends",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/harness/compare_backends.py",
      "cwd": "${workspaceFolder}/harness",
      "console": "integratedTerminal"
    },
    {
      "name": "plot (figures)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/harness/plot.py",
      "cwd": "${workspaceFolder}/harness",
      "console": "integratedTerminal"
    },
    {
      "name": "current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}/harness",
      "console": "integratedTerminal"
    }
  ]
}
